---
// Header component
import { ThemeToggleButton } from "../components";
---

<header class="header">
  <div class="header__brand">
    <a href="/" class="brand__link">Jacob Robin</a>
  </div>
  <nav class="nav">
    <a class="nav__link" href="/about">About</a>
    <ThemeToggleButton />
  </nav>
</header>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--header-border-color);
    background: var(--header-background-color);
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    z-index: 10;
    will-change: transform;

    & .header__brand {
      flex-shrink: 0;
    }

    & .brand__link {
      font-weight: 700;
      font-size: var(--font-size-3);
      text-decoration: none;
      color: var(--title-text-color);
      transition: color 0.2s ease;

      &:hover {
        color: var(--title-text-hover-color);
      }
    }

    & .nav {
      display: flex;
      gap: var(--space-4);
      align-items: center;
    }

    & .nav__link {
      font-weight: 500;
      font-size: var(--font-size-2);
      text-decoration: none;
      color: var(--nav-text-color);
      transition: color 0.2s ease;

      &:hover {
        color: var(--nav-text-hover-color);
      }

      &--home {
        font-weight: 700;
      }
    }
  }

  @media (max-width: 574px) {
    .header {
      padding: var(--space-4) var(--space-3);
    }
  }

  @media (min-width: 575px) {
    .header {
      position: fixed;
      border-bottom: 1px solid var(--border-color);

      & .brand__link {
        font-size: var(--font-size-4);
      }

      & .nav__link {
        font-size: var(--font-size-3);
      }
    }
  }
</style>

<script>
  // Track the last scroll position to calculate scroll direction and distance
  let lastScrollY = 0;
  let header: HTMLElement;

  function updateHeader() {
    // Get current scroll position and calculate how much user scrolled
    const scrollY = window.scrollY;
    const scrollDiff = scrollY - lastScrollY;

    if (!header) return;

    if (scrollY <= 0) {
      // At the top of the page - always show the header fully
      header.style.transform = "translateY(0px)";
    } else {
      // Get the current translateY value from the header's transform style
      const currentY = parseFloat(
        header.style.transform.match(/-?\d+/)?.[0] || "0"
      );

      // Calculate new position: move header opposite to scroll direction
      // - Scroll down (positive scrollDiff) → move header up (subtract from currentY)
      // - Scroll up (negative scrollDiff) → move header down (add to currentY)
      // Clamp between 0 (fully visible) and -headerHeight (fully hidden)
      const newY = Math.max(
        Math.min(currentY - scrollDiff, 0),
        -header.offsetHeight
      );

      header.style.transform = `translateY(${newY}px)`;
    }

    // Store current scroll position for next comparison
    lastScrollY = scrollY;
  }

  function init() {
    // Find the header element and set up scroll tracking
    header = document.querySelector(".header")!;
    header.style.transform = "translateY(0px)"; // Start with header visible
    lastScrollY = 0; // Reset scroll tracking

    // Listen for scroll events (passive for better performance)
    window.addEventListener("scroll", updateHeader, { passive: true });
  }

  // Initialize when page loads and when navigating in Astro
  document.addEventListener("DOMContentLoaded", init);
  document.addEventListener("astro:page-load", init);
</script>
